{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping goindex /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "goindex",
  "uid": "goindex-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Pipeline depth",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Parts (est)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [ { "expr": "goindex_parts_total", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Unassigned parts (assembler backlog)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "targets": [ { "expr": "goindex_parts_unassigned", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Releases total",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 9, "y": 1 },
      "targets": [ { "expr": "goindex_releases_total", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Failed (exhausted)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 13, "y": 1 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "expr": "goindex_releases_failed_exhausted", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Unreleased complete binaries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 7, "x": 17, "y": 1 },
      "targets": [ { "expr": "goindex_binaries_unreleased", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Releases by post-process status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [ { "expr": "goindex_releases_by_pp_status", "legendFormat": "{{status}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Assembler backlog (unassigned parts) over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [ { "expr": "goindex_parts_unassigned", "legendFormat": "unassigned", "refId": "A" } ]
    },
    {
      "type": "row",
      "title": "Worker activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "type": "timeseries",
      "title": "Articles pulled / sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "targets": [ { "expr": "rate(goindex_worker_articles_pulled_total[5m])", "legendFormat": "articles/s", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Releases created / renamed per sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "targets": [
        { "expr": "rate(goindex_worker_releases_created_total[5m])", "legendFormat": "created/s", "refId": "A" },
        { "expr": "rate(goindex_worker_releases_renamed_total[5m])", "legendFormat": "renamed/s", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Post-process cycles / sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "targets": [ { "expr": "rate(goindex_worker_cycles_total[5m])", "legendFormat": "cycles/s", "refId": "A" } ]
    },
    {
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Requests / sec by route",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [ { "expr": "sum by (route) (rate(goindex_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx) / sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 23 },
      "targets": [ { "expr": "sum(rate(goindex_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx/s", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Request latency p95 (s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 23 },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(goindex_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A" } ]
    }
  ]
}
